<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft Ambient Halo Glow -->
    <path
        android:fillAlpha="0.18"
        android:fillColor="#F59E0B"
        android:pathData="M54,26 A28,28 0 1,1 53.9,26 Z" />

    <!-- Orbital Horizon Arc (Dawn Sweep) -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="3.5"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round"
        android:pathData="M35,66 C38,76 66,78 74,48" />

    <!-- Radiant Left Facet (Warm Amber) -->
    <path
        android:pathData="M54,30 L54,78 L34,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34"
                android:startY="54"
                android:endX="54"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#D97706" />
                <item android:offset="1.0" android:color="#F59E0B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Radiant Right Facet (Golden Amber) -->
    <path
        android:pathData="M54,30 L74,54 L54,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="54"
                android:endX="74"
                android:endY="54"
                android:type="linear">
                <item android:offset="0.0" android:color="#FBBF24" />
                <item android:offset="1.0" android:color="#F59E0B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Left Accent Facet (Luminous Shimmer) -->
    <path
        android:pathData="M54,30 L45,46 L54,54 Z"
        android:fillColor="#FEF3C7"
        android:fillAlpha="0.85" />

    <!-- Inner Core Diamond Spark (Brilliant White/Gold) -->
    <path
        android:pathData="M54,46 L60,54 L54,62 L48,54 Z"
        android:fillColor="#FFFFFF" />

    <!-- Apex Sapphire Focus Spark -->
    <path
        android:pathData="M54,23 L56,26 L54,29 L52,26 Z"
        android:fillColor="#38BDF8" />

</vector>
